# Copy to .env for local dev. Never commit the real .env — it's gitignored.
# See README.md "Env vars" for what each of these means and where it comes from.

PORT=8787

# --- OpenClaw Gateway (server/src/gateway) ---
# "stub" runs the in-process fake gateway (gateway/stubGatewayFactory.ts) —
# no real OpenClaw install needed. "real" talks to an actual Gateway; set
# the three vars below to the dedicated client-agent profile's values.
OPENCLAW_GATEWAY_MODE=stub
OPENCLAW_GATEWAY_URL=wss://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=replace-with-a-real-device-token
OPENCLAW_AGENT_ID=sol

# --- WordPress draft proxy (server/src/proxy) ---
# Point at the local stub (packages/stub) for dev, never at
# 2026.solyxenergy.nl or www.solyxenergy.nl from this project.
WORDPRESS_ORIGIN=http://127.0.0.1:8788
WORDPRESS_APP_USER=sol-agent
WORDPRESS_APP_PASSWORD=replace-with-a-real-application-password

# --- Auth mode (server/src/auth/authChecker.ts) ---
# "password" (default) gates a signed session cookie behind a plain
# username+password login form at /login — this app has nothing else
# protecting it once Cloudflare Access is removed, so this is what most
# deployments should run. "access" verifies Cloudflare Access's signed JWT
# on every request instead — nothing else to configure client-side, the
# edge already blocks unauthenticated traffic before it reaches this app.
# "clerk" is a third option for deployments that want a third-party
# identity provider. Only the var group matching this value is required
# below.
AUTH_MODE=password

# --- Password (server/src/auth/passwordAuth.ts + http/loginRoutes.ts) ---
# Required only when AUTH_MODE=password.
#
# SESSION_SECRET signs the session cookie issued after a successful login —
# generate one with e.g. `openssl rand -base64 48`. Must be at least 32
# characters; the server refuses to start otherwise. Treat it like any
# other credential: never commit the real value, rotating it instantly logs
# the owner out everywhere (every existing session cookie stops verifying).
SESSION_SECRET=replace-with-a-real-random-secret-at-least-32-characters-long
#
# AUTH_PASSWORD_HASH is the scrypt hash of the login password, never the
# plaintext password itself. Generate it with:
#   npm run hash-password
# (prompts for the password; or `npm run hash-password -- "the password"`
# to pass it as an argument — only do that on a machine where you don't
# mind it briefly in shell history). Paste the printed
# AUTH_PASSWORD_HASH=... line here.
AUTH_PASSWORD_HASH=replace-with-the-output-of-npm-run-hash-password
#
# AUTH_USERNAME is optional. The login form always shows a username field
# (costs nothing, helps a password manager save the right entry), but it's
# only actually checked if this is set — leave it blank to accept any
# username and gate on the password alone.
AUTH_USERNAME=
#
# Session cookie lifetime, in days. Default 30 — one user, a business
# owner, who shouldn't have to log in daily.
SESSION_MAX_AGE_DAYS=30
#
# TRUSTED_PROXY_HEADER is unset by default, meaning the login rate limiter
# (http/loginRateLimiter.ts) buckets by the raw TCP socket address. Only set
# this if this app is deployed such that a single proxy is the SOLE way to
# reach it (e.g. this project's real deployment: cloudflared bound directly
# to this process on loopback, no other ingress) — in that case, set it to
# the header that proxy attaches with the real client's address, e.g.:
#   TRUSTED_PROXY_HEADER=CF-Connecting-IP
# Do NOT set this if the app is reachable any other way (bound to 0.0.0.0,
# a second ingress path, etc.) — the header would then be attacker-settable,
# defeating the rate limiter entirely. See README.md "Auth" for the full
# explanation.
TRUSTED_PROXY_HEADER=

# --- Cloudflare Access (server/src/auth/accessAuth.ts) ---
# Required only when AUTH_MODE=access. CF_ACCESS_TEAM_DOMAIN is the Zero
# Trust team domain, e.g. "myteam.cloudflareaccess.com" — its
# /cdn-cgi/access/certs endpoint is the JWKS used to verify tokens.
# CF_ACCESS_AUD is the AUD tag of the Access application protecting this
# app's public hostname (Zero Trust dashboard -> Access -> Applications ->
# the app -> Overview). Neither value is secret, but there's nothing to
# gain from committing real ones either.
CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-the-access-application-aud-tag

# --- Clerk (server/src/auth/clerkAuth.ts + web/src/env.ts) ---
# Required only when AUTH_MODE=clerk. The secret key is server-only. The
# publishable key is not secret and is also read by the frontend build as
# VITE_CLERK_PUBLISHABLE_KEY (same value, set once here — see package.json
# scripts for how it's threaded through).
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# --- Static frontend (server/src/index.ts) ---
# Where the server looks for the built frontend (packages/web/dist) to
# serve, relative to packages/server's cwd.
STATIC_DIR=../web/dist
