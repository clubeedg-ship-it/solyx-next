{
  "name": "@solyx-webui/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Static three-column frontend: session list, chat, live draft panel. Talks only to this project's own thin backend, never to the Gateway or WordPress directly.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.14",
    "@assistant-ui/react-markdown": "0.14.11",
    "@clerk/react": "6.14.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "assistant-stream": "0.3.37",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "3.2.7"
  }
}
