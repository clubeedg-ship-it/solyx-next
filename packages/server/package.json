{
  "name": "@solyx-webui/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Thin backend: holds the OpenClaw Gateway credential and the WordPress application password, brokers both to the browser. The browser never sees either.",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "hash-password": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.16.4",
    "@openclaw/gateway-client": "2026.8.1-beta.1",
    "@openclaw/gateway-protocol": "2026.8.1-beta.1",
    "jose": "6.2.8",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "@types/ws": "8.18.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
